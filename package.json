{
  "name": "eeat-studio-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "EEAT Studio V2 — Lean Rebuild: 7 Modules, 8 Tables, 5-Step Write Pipeline",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import tsx/esm server/index.ts",
    "dev:all": "start-server-and-test dev:server http://localhost:3002 dev",
    "build": "vite build",
    "postbuild": "node -e \"try{const fs=require('fs'); fs.copyFileSync('dist/index.html','dist/404.html'); fs.copyFileSync('dist/index.html','dist/login.html'); fs.mkdirSync('dist/projects',{recursive:true}); fs.copyFileSync('dist/index.html','dist/projects/index.html'); fs.mkdirSync('dist/kcp',{recursive:true}); fs.copyFileSync('dist/index.html','dist/kcp/index.html'); fs.mkdirSync('dist/system',{recursive:true}); fs.copyFileSync('dist/index.html','dist/system/index.html'); console.log('[postbuild] SPA fallback static files created: 404/login/projects/kcp/system'); }catch(e){console.error('[postbuild] WARN:',e.message);}\"",
    "build:strict": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --import tsx/esm tests/smoke/pipeline_mock_llm_smoke.test.ts",
    "db:gen": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "phase0:verify": "node --import tsx/esm db/verify_phase0.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@trpc/server": "^10.45.4",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.2",
    "clsx": "^2.1.1",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.0",
    "express": "^5.2.1",
    "jose": "^6.2.9",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.2",
    "mysql2": "^3.23.3",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "node-ssh": "^13.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "sonner": "^1.7.1",
    "ssh2-promise": "^1.0.3",
    "streamdown": "^2.6.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.5.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^25.0.1",
    "start-server-and-test": "^2.0.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.4"
  },
  "packageManager": "npm@10.0.0+engines"
}
